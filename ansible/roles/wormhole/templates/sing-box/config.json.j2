{# --- Deterministic peer ordering --- #}
{%- set deterministic_peers = stable_peers | default(peers | unique | sort) -%}

{# --- DNS/rule sources and advertised prefixes --- #}
{%- set _rules_ip_cidrs = wormhole_composed.advertise_cidrs | default([]) -%}
{%- set _has_profile_ruleset = (wormhole_composed.domain_suffixes | default([])) | length > 0 -%}
{%- set advertise_routes = [fakeip_inet4_range, fakeip_inet6_range] + _rules_ip_cidrs -%}
{%- set peer_custom_rules = deterministic_peers | map('extract', hostvars) | map(attribute='dns.local_domains', default=[]) | flatten -%}

{# --- Route exclusion inputs for local TUN inbounds --- #}
{%- set peer_host_routes = deterministic_peers | map('extract', hostvars) | map(attribute='ansible_host') | map('regex_replace', '$', '/32') | list -%}
{%- set local_host_route = [ansible_host ~ '/32'] -%}
{%- set tun_route_excludes = local_host_route + peer_host_routes -%}

{# --- Protocol-specific helper values (WG/VLESS) --- #}
{%- set _peer_source_cidrs = peer_source_cidrs | default({}) -%}
{%- set _wg_clients = wireguard_clients_with_keys if wireguard_clients_with_keys is defined else [] -%}
{%- set _has_wg_endpoints = wg_private_key is defined and (_wg_clients | length) > 0 -%}
{%- set _vless_clients = vless_clients_with_credentials if vless_clients_with_credentials is defined else [] -%}
{%- set _vpn_inbounds = ['awg-in'] + (['wg-ep'] if _has_wg_endpoints else []) -%}
{%- set _wg_addrs = [] -%}
{%- for p in deterministic_peers -%}
  {%- set _cidr = hostvars[p]['wg']['subnet'] | default(wg.subnet) -%}
  {%- set _net = _cidr.split('/') -%}
  {%- set _ = _wg_addrs.append(_net[0].rsplit('.', 1)[0] ~ '.1/' ~ _net[1]) -%}
{%- endfor -%}
{%- set _wg_addrs = _wg_addrs | unique | list -%}
{%- set _wg_unique = {} -%}
{%- for client in _wg_clients -%}
  {%- if client.key_id not in _wg_unique -%}
    {%- set _ = _wg_unique.update({client.key_id: client}) -%}
  {%- endif -%}
{%- endfor -%}
{%- set _wg_unique_clients = _wg_unique | dict2items | map(attribute='value') | list -%}
{
  "dns": {
    "final": "upstream-local",
    "independent_cache": true,
    "rules": [
      {
        "query_type": ["HTTPS", "AAAA"],
        "action": "reject",
        "reject_code": 3
      }{% if _has_profile_ruleset %},
      {
        "rule_set": ["profile"],
        "query_type": ["A", "AAAA"],
        "server": "fakeip"
      },
      {
        "rule_set": ["profile"],
        "server": "upstream-local"
      }{% endif %}{% if peer_custom_rules %},
      {
        "domain_suffix": {{ peer_custom_rules | to_json }},
        "query_type": ["A", "AAAA"],
        "server": "fakeip"
      },
      {
        "domain_suffix": {{ peer_custom_rules | to_json }},
        "server": "upstream-local"
      }{% endif %}{% for peer in deterministic_peers if (_peer_source_cidrs[peer] | default([])) | length > 0 %},
      {
        "source_ip_cidr": {{ _peer_source_cidrs[peer] | to_json }},
        "server": "upstream-tunnel-{{ peer }}"
      }{% endfor %}
    ],
    "servers": [
{% for peer in deterministic_peers %}
      {
        "type": "udp",
        "tag": "upstream-tunnel-{{ peer }}",
        "server": "{{ hostvars[peer]['dns']['local_server']}}",
        "detour": "peer-{{ peer }}"
      },
{% endfor %}
      {
        "type": "udp",
        "tag": "upstream-local",
        "server": "{{ dns.local_server }}",
        "detour": "direct-lo"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "{{ fakeip_inet4_range }}",
        "inet6_range": "{{ fakeip_inet6_range }}"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "path": "/var/lib/sing-box/cache.db"
    }
  },
  "endpoints": [
{% for peer in deterministic_peers %}
    {
      "advertise_exit_node": true,
      "advertise_routes": {{ advertise_routes | to_json }},
{% if vault_tailscale_auth_key is defined and vault_tailscale_auth_key %}
      "auth_key": "{{ vault_tailscale_auth_key }}",
{% endif %}
      "ephemeral": false,
      "hostname": "{{ tailscale.base_hostname }}-{{ inventory_hostname }}-{{ peer }}",
      "state_directory": "/var/lib/sing-box/tailscale-{{ peer }}",
      "tag": "ts-ep-{{ peer }}",
      "type": "tailscale"
    }{% if not loop.last or _has_wg_endpoints %},{% endif %}
{% endfor %}
{% if _has_wg_endpoints %}
    {
      "type": "wireguard",
      "tag": "wg-ep",
      "address": {{ _wg_addrs | to_json }},
      "listen_port": {{ wg.port | int }},
      "private_key": "{{ wg_private_key }}",
      "peers": [
{% for client in _wg_unique_clients %}
        {
          "public_key": "{{ client.public_key }}",
          "allowed_ips": ["{{ client.ip }}/32"]
        }{% if not loop.last %},{% endif %}
{% endfor %}
      ]
    }{% endif %}
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "awg-in",
      "interface_name": "sb-awg-in",
      "address": ["172.19.10.1/30"],
      "include_interface": ["awg-in"],
      "route_exclude_address": {{ tun_route_excludes | unique | list | to_json }},
      "auto_route": true,
      "strict_route": true,
      "mtu": 9000
    },
    {
      "type": "hysteria2",
      "tag": "tunnel-in",
      "listen": "0.0.0.0",
      "listen_port": {{ hysteria2.port }},
      "users": [
        { "password": "{{ vault_hysteria2_password }}" }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/tls/cert.pem",
        "key_path": "/etc/sing-box/tls/key.pem"
      }
    }{% if (_vless_clients | length) > 0 %},
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "0.0.0.0",
      "listen_port": {{ vless.port }},
      "users": [
{% for client in _vless_clients %}
        {
          "name": "{{ client.auth_user }}",
          "uuid": "{{ client.uuid }}"
        }{% if not loop.last %},{% endif %}
{% endfor %}
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ vless.domain }}",
        "min_version": "1.3",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{ vless.domain }}",
            "server_port": {{ vless.handshake_port | int }}
          },
          "private_key": "{{ vless.private_key }}",
          "short_id": ["{{ vless.short_id }}"],
          "max_time_difference": "{{ vless.max_time_difference }}"
        }
      },
      "transport": {
        "type": "grpc",
        "service_name": "{{ vless.grpc_service_name }}"
      }
    }{% endif %}
  ],
  "log": {
    "level": "{{ log.level }}"
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "direct-lo",
      "type": "direct",
      "bind_interface": "lo"
    },
{% for peer in deterministic_peers %}
    {
      "tag": "peer-{{ peer }}",
      "type": "hysteria2",
      "server": "{{ hostvars[peer]['ansible_host'] }}",
      "server_port": {{ hysteria2.port }},
      "password": "{{ vault_hysteria2_password }}",
      "tls": {
        "enabled": true,
        "insecure": true
      }
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "route": {
    "auto_detect_interface": true,
    "rule_set": [
      {
        "tag": "profile",
        "type": "local",
        "format": "binary",
        "path": "/etc/sing-box/rule-set.srs"
      }
    ],
    "default_domain_resolver": {
      "server": "upstream-local"
    },
    "final": "direct",
    "rules": [
      {
        "inbound": ["tunnel-in"],
        "port": [53],
        "action": "route",
        "outbound": "direct-lo"
      },
      {
        "ip_cidr": ["127.0.0.0/8"],
        "port": [53],
        "action": "route",
        "outbound": "direct-lo"
      },
      {
        "inbound": {{ _vpn_inbounds | to_json }},
        "port": [53],
        "action": "hijack-dns"
      }{% for peer in deterministic_peers %}
{%- set peer_vless_auth_users = _vless_clients | selectattr('selected_peer', 'equalto', peer) | map(attribute='auth_user') | list -%}
{%- if (_peer_source_cidrs[peer] | default([])) | length > 0 -%}
,
      {
        "inbound": {{ _vpn_inbounds | to_json }},
        "source_ip_cidr": {{ _peer_source_cidrs[peer] | to_json }},
        "action": "route",
        "outbound": "peer-{{ peer }}"
      }{% endif %}{% if peer_vless_auth_users %},
      {
        "auth_user": {{ peer_vless_auth_users | to_json }},
        "action": "route",
        "outbound": "peer-{{ peer }}"
      }{% endif %},
      {
        "inbound": ["ts-ep-{{ peer }}"],
        "action": "route",
        "outbound": "peer-{{ peer }}"
      }{% endfor %}
    ]
  }
}
