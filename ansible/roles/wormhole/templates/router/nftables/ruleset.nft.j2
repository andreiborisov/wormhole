add table ip wormhole
flush table ip wormhole

table ip wormhole {

  # FILTER

  chain input {
    type filter hook input priority filter; policy accept;
    ct state invalid drop
    ct state established,related accept
    iif lo accept
    iifname "awg-in" accept
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    ct state invalid drop
    ct state established,related accept
    # Client-to-client on awg-in. Internet is policy-routed to sb-awg-in
    # by the router entrypoint (ip rule iif awg-in lookup 100).
    iifname "awg-in" accept
  }

  # NAT
  # Never SNAT into sb-awg-in: that rewrote client IPs to 172.19.10.1 and
  # source_ip_cidr could not pick the Hysteria2 exit (everything looked local).
  # Never SNAT AWG→WAN either: that was the silent leak onto this node's IP.

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "sb-awg-in" return
  }
}
